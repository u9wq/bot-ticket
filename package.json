{
	"name": "bot-ticket",
	"version": "1.0.0",
	"description": "Bot de tickets Discord à préfixe, configurable par panneaux interactifs",
	"main": "src/index.js",
	"type": "module",
	"private": true,
	"imports": {
		"#core/*": "./src/core/*",
		"#tickets/*": "./src/tickets/*",
		"#setup/*": "./src/setup/*"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"start": "node src/index.js",
		"check": "node scripts/check.js"
	},
	"dependencies": {
		"better-sqlite3": "12.9.0",
		"discord.js": "^14.27.0",
		"dotenv": "^18.0.3"
	},
	"allowScripts": {
		"better-sqlite3@12.9.0": true
	}
}
