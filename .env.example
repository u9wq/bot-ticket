# ─── Obligatoire ──────────────────────────────────────────────────────────────

# Token du bot — https://discord.com/developers/applications > ton application > Bot
# Active aussi « MESSAGE CONTENT INTENT » sur la même page : sans lui, le bot
# ne lit pas les commandes à préfixe.
TOKEN=

# ─── Facultatif ───────────────────────────────────────────────────────────────

# Identifiants des propriétaires du bot, séparés par des virgules.
# Ils ont l'accès admin sur tous les serveurs, en plus des membres qui ont
# la permission « Gérer le serveur ».
OWNERS=

# Préfixe et couleur d'un nouveau serveur. Ensuite, chaque serveur règle les
# siens depuis Discord avec +setup (ou +prefix).
PREFIX=+
COLOR=#5865F2

# Chemin de la base SQLite. Par défaut : data/bot.sqlite
DB_PATH=
